# Credenciais SMTP do Zoho Mail — usadas só por api/contato.js.
# Nunca commitar valores reais. Configure-as no painel da Vercel
# (Project Settings → Environment Variables) e, se quiser rodar
# `vercel dev` localmente, copie este arquivo para .env com os valores reais.

ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
# Conta completa do Zoho Mail que vai autenticar e aparecer como remetente.
ZOHO_SMTP_USER=contato@seudominio.com.br
# Senha de aplicativo do Zoho (não é a senha normal da conta) — gerada em
# Zoho Mail → Configurações → Segurança → Senhas de aplicativo.
ZOHO_SMTP_PASS=
